{
  "name": "second-look-extension",
  "displayName": "Second Look",
  "description": "The reviewer's companion: ranks a pull request by what matters, so the human reviews it faster and better.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "publisher": "lbildzinkas",
  "repository": {
    "type": "git",
    "url": "https://github.com/lbildzinkas/second-look"
  },
  "engines": {
    "node": ">=20",
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "contributes": {
    "commands": [
      {
        "command": "second-look.reviewPullRequest",
        "title": "Review pull request",
        "category": "Second Look"
      },
      {
        "command": "second-look.openPart",
        "title": "Open part in the diff editor",
        "category": "Second Look"
      },
      {
        "command": "second-look.openAllParts",
        "title": "Open all parts in order",
        "category": "Second Look"
      },
      {
        "command": "second-look.submitReview",
        "title": "Submit review…",
        "category": "Second Look"
      },
      {
        "command": "second-look.addComment",
        "title": "Add comment",
        "category": "Second Look"
      },
      {
        "command": "second-look.commentOnPart",
        "title": "Comment on this part…",
        "category": "Second Look"
      },
      {
        "command": "second-look.discardComment",
        "title": "Discard comment",
        "category": "Second Look"
      },
      {
        "command": "second-look.openOverview",
        "title": "Open overview",
        "category": "Second Look",
        "icon": "$(book)"
      },
      {
        "command": "second-look.whyThisMatters",
        "title": "Why this matters",
        "category": "Second Look",
        "icon": "$(info)"
      },
      {
        "command": "second-look.fetchLibrary",
        "title": "Fetch the library's source",
        "category": "Second Look"
      },
      {
        "command": "second-look.openLibraryEvidence",
        "title": "Open the cited library file",
        "category": "Second Look"
      },
      {
        "command": "second-look.draftComment",
        "title": "Draft comment",
        "category": "Second Look"
      },
      {
        "command": "second-look.addDraft",
        "title": "Add to review",
        "category": "Second Look"
      },
      {
        "command": "second-look.discardDraft",
        "title": "Discard draft",
        "category": "Second Look"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "second-look.openAllParts",
          "when": "view == second-look.reviewTree",
          "group": "navigation",
          "icon": "$(diff-multiple)"
        },
        {
          "command": "second-look.submitReview",
          "when": "view == second-look.reviewTree",
          "group": "navigation",
          "icon": "$(rocket)"
        },
        {
          "command": "second-look.openOverview",
          "when": "view == second-look.reviewTree",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "second-look.openPart",
          "when": "false"
        },
        {
          "command": "second-look.addComment",
          "when": "false"
        },
        {
          "command": "second-look.commentOnPart",
          "when": "false"
        },
        {
          "command": "second-look.discardComment",
          "when": "false"
        },
        {
          "command": "second-look.whyThisMatters",
          "when": "false"
        },
        {
          "command": "second-look.fetchLibrary",
          "when": "false"
        },
        {
          "command": "second-look.openLibraryEvidence",
          "when": "false"
        },
        {
          "command": "second-look.draftComment",
          "when": "false"
        },
        {
          "command": "second-look.addDraft",
          "when": "false"
        },
        {
          "command": "second-look.discardDraft",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "second-look.addComment",
          "when": "commentController == second-look",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "second-look.discardComment",
          "when": "commentThread == second-look-pending"
        }
      ],
      "comments/comment/context": [
        {
          "command": "second-look.discardDraft",
          "when": "commentController == second-look && comment == second-look-draft",
          "group": "inline@1"
        },
        {
          "command": "second-look.addDraft",
          "when": "commentController == second-look && comment == second-look-draft",
          "group": "inline@2"
        }
      ],
      "view/item/context": [
        {
          "command": "second-look.commentOnPart",
          "when": "view == second-look.reviewTree && viewItem == part",
          "group": "navigation"
        },
        {
          "command": "second-look.commentOnPart",
          "when": "view == second-look.reviewTree && viewItem == noise",
          "group": "navigation"
        },
        {
          "command": "second-look.whyThisMatters",
          "when": "view == second-look.reviewTree && viewItem == part",
          "group": "inline"
        },
        {
          "command": "second-look.whyThisMatters",
          "when": "view == second-look.reviewTree && viewItem == noise",
          "group": "inline"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "second-look.reviewTree",
          "name": "Second Look"
        }
      ]
    },
    "configuration": {
      "title": "Second Look",
      "properties": {
        "second-look.agent": {
          "type": "string",
          "enum": [
            "pi",
            "claude-code"
          ],
          "default": "pi",
          "description": "The installed coding agent the companion drives for every agent pass of a review: Pi or Claude Code. The choice travels with each review request, so switching it and re-running a review needs no engine restart and stamps every agent-produced result with the new agent: the grouping pass always runs on it, and the ranking pass runs on it only where the agent, model and effort have an evaluation whose ranking matched or beat the plain one — each result's ranking says which ranking is shown and why. The status bar shows the agent in use. An agent that is missing, or a version too old for the companion's lockdown, is never run: the engine's agent probe reports what is missing."
        },
        "second-look.agentModel": {
          "type": "string",
          "default": "",
          "description": "The model the selected agent runs for every agent pass of a review, in the agent's own naming: for example `anthropic/claude-sonnet-5` for Pi or `sonnet` for Claude Code. Empty uses the agent's own default model. The model is stamped on every agent-produced result, and the status bar shows the model in use."
        },
        "second-look.agentAccount": {
          "type": "string",
          "default": "",
          "description": "A label for the account or subscription the agent bills, such as `Claude Max (work address)` or `Pi personal key`, stamped on every agent-produced result of a review and shown in the status bar beside the agent and model. The companion never reads the agent's login: this label is what you tell it. For Claude Code, the status bar warns when an inherited ANTHROPIC_API_KEY overrides the Claude subscription."
        },
        "second-look.criteriaHeading": {
          "type": "string",
          "default": "Acceptance criteria",
          "description": "The heading the acceptance criteria checklist sits under in the issues a pull request links. The companion reads every task-list item under it — closing references, sidebar links and issues in other repositories alike — and lists each one in the overview, quoted and not checked until the agent maps it to the change. The heading travels with each review request, so changing it and re-running a review reads the new checklist; GitHub returns no closing references for a pull request into a non-default branch, and the overview says so."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@second-look/engine": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
